{
  "name": "akademija-ibn-usejmin",
  "type": "module",
  "scripts": {
    "dev": "bun run build:wc --watch & bun run dev:server",
    "build:wc": "bun build ./src/ui/web-components/*.wc.ts --outdir=./src/ui/generated/web-components --watch",
    "dev:server": "bun --hot ./src/index.tsx --host 0.0.0.0",
    "test": "bun run test:unit && bun run test:type && bun run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:type": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.73.0",
    "playwright": "^1.60.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  }
}
